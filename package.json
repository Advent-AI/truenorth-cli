{
  "name": "@truenorth-ai/cli",
  "version": "0.6.0",
  "description": "TrueNorth CLI for dynamically discovering and calling TrueNorth agent tools.",
  "homepage": "https://truenorth.xyz",
  "author": "TrueNorth",
  "type": "module",
  "bin": {
    "tn": "bin/truenorth.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "truenorth",
    "agent",
    "agent-skill",
    "mcp",
    "claude",
    "ai-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
